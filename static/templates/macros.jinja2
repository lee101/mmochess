{% macro jsvars() -%}
    <script>
        window.fixtures = (function () {
            "use strict";
            var self = {};
            self.pieces = {
                'queen': '♚',
                'king': '♛',
                'castle': '♜',
                'bishop': '♝',
                'horse': '♞',
                'pawn': '♟'
            };
            self.piecesPower = {
                'king': 200,
                'queen': 9,
                'castle': 5,
                'bishop': 4.5,
                'horse': 4,
                'pawn': 1
            };
            return self;
        })();

    </script>
{%- endmacro %}


{%- macro responsiveAd(slot="7003733604", class_name="adsbygoogle", layout="display:block", format="auto", full_width="true") %}
<ins class="{{ class_name }}" style="{{ layout }}"
     data-ad-client="ca-pub-8598649123553748"
     data-ad-slot="{{ slot }}"
     data-ad-format="{{ format }}"
     data-full-width-responsive="{{ full_width }}"></ins>
<script>
    (adsbygoogle = window.adsbygoogle || []).push({});
</script>
{%- endmacro %}
