{% extends 'templates/base.jinja2' %}

{% block headers %}

    {% set title = 'Big Multiplayer Chess - Free 6 Player Chess Game Online' -%}
    {% set description = 'Free multiplayer chess in your browser: up to 6 armies on one giant board, plus classic 1v1 on a bigger board. No download needed.' -%}

    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <meta name="keywords" content="puzzle games, chess, online chess, free online puzzle games, multiplayer chess game">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="https://{{ request.url.netloc }}{{ path }}">
    <meta property="og:image" content="https://{{ request.url.netloc }}/static/img/og-bigmultiplayerchess.png">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="game">
    <meta property="og:site_name" content="Big Multiplayer Chess">
    <meta property="fb:admins" content="337972272904903">


{% endblock %}

{% block mainbody %}
    {% include "/templates/shared/start.jinja2" %}
{% endblock %}
