{
  "name": "mmochess",
  "version": "1.0.0",
  "description": "Big Multiplayer Chess - Desktop Edition",
  "main": "electron/main.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "grunt": "^0.4.3",
    "grunt-contrib-less": "1.0.1",
    "grunt-contrib-watch": "^0.5.3",
    "grunt-nunjucks": "^0.1.3",
    "nunjucks": "2.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.20.0",
    "grunt-cli": "^1.5.0"
  },
  "scripts": {
    "prebuild": "grunt nunjucks && grunt less",
    "build:js": "node scripts/bundle-js.js",
    "build:css": "node scripts/bundle-css.js",
    "build:html": "node scripts/build-html.js",
    "build": "npm run prebuild && npm run build:css && npm run build:js && npm run build:html",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.bigmultiplayerchess.desktop",
    "productName": "Big Multiplayer Chess",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "static/img/**/*",
      "static/icons/**/*",
      "static/music/**/*",
      "gameon/static/bower_components/font-awesome/fonts/**/*",
      "gameon/static/js/lib/soundmanager/swf/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "static/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "static/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "static/icons"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lee101/mmochess.git"
  },
  "keywords": [
    "chess",
    "multiplayer",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lee101/mmochess/issues"
  },
  "homepage": "https://github.com/lee101/mmochess"
}
